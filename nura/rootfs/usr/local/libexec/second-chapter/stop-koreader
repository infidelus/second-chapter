#!/bin/sh
#
# Second Chapter: ask KOReader to close properly, and wait for it.
#
# KOReader treats SIGTERM like the "close" button: every open screen closes
# (the book screen saves your place as it does) and then KOReader quits.
# Run by second-chapter-fb.service (ExecStop) when the KOReader service stops,
# whether restarting or shutting down.
#
# Each step is recorded in the system log (journalctl -t second-chapter).

log() {
    logger -t second-chapter "stop-koreader: $*"
}

# Find KOReader by looking through the running processes directly.
# (pgrep didn't find it when run by systemd, although it did by hand.)
find_koreader() {
    for dir in /proc/[0-9]*; do
        cmdline=$(tr '\0' ' ' < "$dir/cmdline" 2>/dev/null) || continue
        program=${cmdline%% *}
        # The program itself must be luajit, running reader.lua
        case "$program" in
            luajit|*/luajit)
                case "$cmdline" in
                    *reader.lua*) echo "${dir#/proc/}" ;;
                esac
                ;;
        esac
    done
}

pids=$(find_koreader)
if [ -z "$pids" ]; then
    log "KOReader isn't running; nothing to do ($(ls -d /proc/[0-9]* | wc -l) processes visible, running as user $(id -u))"
    exit 0
fi

log "asking KOReader (process $pids) to close"
kill -TERM $pids

# Wait up to 15 seconds for KOReader to finish saving and quit.
i=0
while [ "$i" -lt 15 ]; do
    if [ -z "$(find_koreader)" ]; then
        log "KOReader closed after about ${i}s"
        exit 0
    fi
    sleep 1
    i=$((i + 1))
done

log "KOReader didn't close within 15 seconds; carrying on"
exit 0
